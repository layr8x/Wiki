{
  "name": "sdij-wiki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.7",
  "overrides": {
    "tsx": "^4.22.4"
  },
  "scripts": {
    "dev": "vite",
    "build:guide-index": "node scripts/build-guide-index.mjs",
    "prebuild": "test -f scripts/build-guide-index.mjs && node scripts/build-guide-index.mjs || true; node scripts/build-cs-stats.mjs || true",
    "build:cs-stats": "node scripts/build-cs-stats.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "db:seed": "node supabase/generate-seed.mjs",
    "sync:confluence": "node scripts/sync-confluence.mjs",
    "sync:kakao-chats": "node scripts/sync-kakao-chats.mjs",
    "classify:kakao": "node scripts/classify-kakao-csv.mjs",
    "classify:kakao:db": "node --env-file=.env.local scripts/classify-kakao-stream.mjs",
    "update:cs-insights": "node scripts/update-cs-insights.mjs",
    "cs-pipeline": "npm run sync:kakao-chats && node scripts/run-cs-pipeline.mjs",
    "kakao:bootstrap": "node --env-file=.env.local scripts/kakao-partner-bootstrap.mjs",
    "kakao:backfill": "node --env-file=.env.local scripts/kakao-partner-backfill.mjs",
    "kakao:collect-once": "node --env-file=.env.local scripts/kakao-partner-collect-once.mjs",
    "kakao:bootstrap:all": "node --env-file=.env.local scripts/kakao-partner-run-all.mjs kakao-partner-bootstrap.mjs",
    "kakao:backfill:all": "node --env-file=.env.local scripts/kakao-partner-run-all.mjs kakao-partner-backfill.mjs",
    "kakao:status": "node --env-file=.env.local scripts/kakao-partner-status.mjs",
    "kakao:refresh-cookie": "node --env-file=.env.local scripts/kakao-partner-refresh-cookie.mjs",
    "kakao:export": "node --env-file=.env.local scripts/kakao-partner-export-csv.mjs",
    "kakao:dashboard": "node --env-file=.env.local scripts/kakao-partner-dashboard.mjs",
    "kakao:sheets-sync": "node --env-file=.env.local scripts/kakao-partner-sheets-sync.mjs",
    "jandi:collect-once": "node --env-file=.env.local scripts/jandi-collect-once.mjs",
    "jandi:backfill": "node --env-file=.env.local scripts/jandi-backfill.mjs",
    "jandi:refresh-token": "node --env-file=.env.local scripts/jandi-refresh-token.mjs",
    "extract:qa-dataset": "node --env-file=.env.local scripts/extract-qa-dataset.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.1.3",
    "@astryxdesign/core": "^0.1.3",
    "@astryxdesign/theme-neutral": "^0.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
