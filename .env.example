# =============================================================================
# AMS Wiki — 환경 변수 설정
# =============================================================================
# 이 파일을 .env 로 복사한 후 값을 채워주세요.
# cp .env.example .env

# =============================================================================
# Supabase (필수 — DB + Auth)
# =============================================================================
# Supabase 프로젝트 URL  (예: https://abcdefg.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon key (공개 키)
VITE_SUPABASE_ANON_KEY=

# =============================================================================
# Atlassian OAuth 2.0 (선택 — Jira/Confluence OAuth 인증)
# =============================================================================
# OAuth를 통해 API 토큰 노출 없이 안전한 인증을 제공합니다.
# Atlassian App Registry에서 OAuth 앱 등록 후 아래 값들을 채웁니다.
# 참고: https://developer.atlassian.com/cloud/jira/platform/oauth-2-3lo-apps/
#
# Atlassian Cloud의 "OAuth 2.0 (3LO)" 앱에서:
# 1. 클라이언트 ID
ATLASSIAN_OAUTH_CLIENT_ID=
# 2. 클라이언트 시크릿 (매우 민감함!)
ATLASSIAN_OAUTH_CLIENT_SECRET=
# 3. 리다이렉트 URI (Vercel: https://your-domain.vercel.app/api/oauth/callback)
ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:5173/api/oauth/callback

# =============================================================================
# Confluence API (선택 — 이미지 프록시 + 콘텐츠 동기화)
# =============================================================================
# 모든 Confluence 인증은 서버 사이드에서만 처리합니다.
#  - prod: Vercel Serverless Function (api/confluence-img/[...path].js)
#  - dev : vite.config.js 의 dev 프록시 (동일 서버-사이드 자격증명 사용)
#  - sync: scripts/sync-confluence.mjs (.env.local 직접 읽음)
# VITE_ 접두사는 절대 붙이지 마세요. 클라이언트 번들로 유출됩니다.
#
# OAuth 사용 시 아래 옵션은 선택사항입니다 (레거시 Basic auth 지원).
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
CONFLUENCE_DOMAIN=hiconsy.atlassian.net
CONFLUENCE_SPACE_KEY=FVSOL
CONFLUENCE_ROOT_PAGE_ID=1378910256

# =============================================================================
# Anthropic Claude API (선택 — 검색 AI 요약 카드)
# =============================================================================
# Vercel Serverless Function(api/search-summary.js) 에서만 사용됩니다.
# 클라이언트 번들에 노출되지 않도록 반드시 VITE_ 접두사 없이 설정하세요.
# 값이 비어있으면 검색 오버레이는 AI 요약 카드를 자동으로 숨깁니다.
ANTHROPIC_API_KEY=

# =============================================================================
# Cron Job 보안 (선택 — Vercel Cron 동기화)
# =============================================================================
# Vercel Cron Job 접근 제어용 시크릿
# 랜덤 문자열 생성 권장: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# =============================================================================
# 앱 설정
# =============================================================================
VITE_ENV=development
VITE_API_BASE_URL=http://localhost:5173

# =============================================================================
# 카카오 i 오픈빌더 / 챗봇 Webhook (Supabase Edge Function: kakao-webhook)
# =============================================================================
# 학부모 카카오톡 문의를 자동 분류 → Supabase 저장 → 위키 통계에 반영.
# 상세: docs/KAKAO_WEBHOOK_SETUP.md
#
# 이 토큰은 .env 가 아니라 Supabase Dashboard > Edge Functions > Secrets 에
# 직접 설정해야 합니다 (Edge Function 환경변수로 주입됨).
# 랜덤 문자열 생성: openssl rand -hex 32
# Webhook URL: https://<project>.supabase.co/functions/v1/kakao-webhook?token=<KAKAO_WEBHOOK_TOKEN>
KAKAO_WEBHOOK_TOKEN=

# =============================================================================
# 카카오 비즈니스 채팅 자동 수집 (선택 — scripts/sync-kakao-chats.mjs)
# =============================================================================
# 마이클래스 CS 분석 데이터셋(src/data/csInsights.js)의 원본 카카오 비즈니스
# 채팅 CSV를 사용자 PC에서 자동 추출하기 위한 설정.
# 상세 가이드: scripts/README-kakao-sync.md
#
# 보안 주의: KAKAO_BUSINESS_COOKIE 는 사용자 카카오 계정 로그인 권한과 동등.
# 절대 git 에 커밋하지 말 것 (.env.local 사용 권장).
KAKAO_BUSINESS_COOKIE=
KAKAO_CHANNEL_ID=
KAKAO_OUTPUT_CSV=
KAKAO_MAX_THREADS=0
KAKAO_HEADLESS=true
KAKAO_MASK_PII=true
KAKAO_SINCE_DAYS=0

# =============================================================================
# 카카오 파트너센터 로컬 스크립트용 (bootstrap · backfill · refresh-cookie 등)
# =============================================================================
# 상시 수집 자체는 Supabase Edge Function `kakao-collect`(pg_cron)가 담당한다.
# 상세: docs/KAKAO_PARTNER_SETUP.md
#
# 보안 주의: KAKAO_PARTNER_COOKIE 는 카카오 계정 로그인 권한과 동등.
# 절대 git/브라우저/Slack 에 노출하지 말 것 (.env.local 만 사용).
KAKAO_PARTNER_PROFILE_ID=_VGAQn
# 다중 채널 수집(collect-once 등) — CSV. 설정 시 _ID 보다 우선. 5채널 정본은 CLAUDE.md §16 참고.
KAKAO_PARTNER_PROFILE_IDS=_VGAQn,_rcpPG,_TkpPG,_xfxilXn,_rkbcn
KAKAO_PARTNER_COOKIE=
# Supabase service_role key (스크립트 전용 — RLS 우회).
# anon key 와 다름. Supabase Dashboard > Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 옵션 (기본값으로 충분)
KAKAO_PARTNER_PAGE_SIZE=100
KAKAO_PARTNER_MAX_PAGES=50
KAKAO_PARTNER_POLL_MS=60000
KAKAO_PARTNER_DUMP_RAW=true
KAKAO_PARTNER_DUMP_PATH=./kakao-partner-raw.log
# 쿠키 만료(401) 시 데몬이 Chrome 에서 쿠키를 자동 재추출해 자가복구 (macOS 전용). 끄려면 0.
KAKAO_PARTNER_AUTO_REFRESH=1
# kakao:status 에서 최신 메시지가 이 분(min)보다 오래되면 STALE 로 표시.
KAKAO_STATUS_STALE_MIN=15

# ─── 잔디(JANDI) 대화 수집 (선택 — scripts/jandi-collect-once.mjs) ───────────
# 잔디는 대화 전체를 내보내는 웹훅이 없어(아웃고잉 웹훅=트리거 단어 한정), 카카오와 동일하게
# 로그인 세션 access token 으로 내부 API(i1.jandi.com)를 방별 폴링해 적재한다.
# 상세/토큰 추출: docs/JANDI_SETUP.md
# 보안 주의: JANDI_ACCESS_TOKEN 은 잔디 로그인 권한과 동등(수명 ~12h). git/브라우저 금지.
# 1차 출처는 Supabase 보관함(jandi_secrets.jandi_access_token). 아래는 로컬/폴백용.
JANDI_ACCESS_TOKEN=
JANDI_TEAM_ID=29522216
JANDI_MEMBER_ID=
# 옵션 (기본값으로 충분)
JANDI_PAGE_SIZE=50
JANDI_MAX_PAGES=8
# 전체 백필(jandi:backfill) 방당 페이지 상한 — 기본 100000(사실상 무제한).
JANDI_BACKFILL_MAX_PAGES=100000

# 토큰 자동 갱신(jandi:refresh-token) — 헤드리스 로그인으로 새 access token 을 배달.
# 보안 주의: 잔디 로그인 자격증명. .env.local(로컬)/CI Secret 에만 두고 절대 커밋 금지.
# SSO/2단계 인증(MFA) 사용 시 헤드리스 로그인이 막힐 수 있음 → 그 경우 수동 토큰 갱신.
JANDI_EMAIL=
JANDI_PASSWORD=
# 옵션 (기본값으로 충분)
JANDI_HEADLESS=true
JANDI_REFRESH_TIMEOUT_MS=60000

# ─── 매니저 FAQ 실시간 소스 (선택) ──────────────────────────────────────────
# 챗봇/FAQ 가 참조하는 가이드를 외부에서 실시간으로 받아올 때만 설정.
# 미설정 시 앱 내 번들 데이터(src/data/managerFaq.js)를 단일 원본으로 사용한다.
# 클라이언트가 직접 fetch 하므로(서버리스 함수 미사용) 외부 주소는 CORS 허용 +
# 공개 접근(또는 토큰을 쿼리스트링에 포함)이어야 한다. Vite 빌드 시 주입되도록
# 반드시 VITE_ 접두사를 사용한다.
#   - JSON 을 반환하는 데이터 주소. 형태: [{q,a,category,guideId}] 또는 {faq:[...]}
VITE_MANAGER_FAQ_URL=
